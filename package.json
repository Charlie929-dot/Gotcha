{
  "name": "gotcha",
  "productName": "Gotcha",
  "version": "0.1.0",
  "description": "记忆球（Gotcha / MemoryOrb）——常驻 Windows 桌面边缘的记忆球：记录屏幕使用，沉淀成可缩放探索的关系图谱（M1a 采集存储底座）",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:capture": "electron-vite dev -- --capture",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "active-win": "9.0.0",
    "better-sqlite3": "13.0.3",
    "electron-log": "5.4.4"
  }
}
