{
  "name": "gotcha",
  "productName": "Gotcha",
  "version": "0.1.0",
  "description": "记忆球（Gotcha / MemoryOrb）——常驻 Windows 桌面边缘的记忆球：记录屏幕使用，沉淀成可缩放探索的关系图谱（M1a 采集存储底座）",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:capture": "electron-vite dev -- --capture",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "typecheck": "tsc --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "chain-hook-smoke": "node scripts/chain-hook-smoke.mts",
    "recall-baseline": "node scripts/recall-baseline.mts",
    "chain-probe": "node scripts/chain-probe/analyze.mts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/d3-color": "^3.1.3",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.6.5",
    "d3-color": "^3.1.0",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "force-graph": "1.51.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "lit": "^3.3.3",
    "sigma": "4.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "active-win": "9.0.0",
    "better-sqlite3": "13.0.3",
    "electron-log": "5.4.4",
    "onnxruntime-node": "^1.30.0"
  }
}
